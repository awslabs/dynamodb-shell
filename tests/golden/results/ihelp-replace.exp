REPLACE - Replace items in a table

REPLACE INTO <table> ( column [, column ...] ) VALUES ( values ) [ratelimit] [return_values]
ratelimit := WITH RATELIMIT ( RR RCU, WW WCU ) |
             WITH RATELIMIT ( RR RCU ) |
             WITH RATELIMIT ( WW WCU )

return_values: RETURN VALUES [ALL OLD|ALL NEW|UPDATED OLD|UPDATED NEW]

