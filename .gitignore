# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# ignore the build directories in their entirety (build/, build-engine/,
# build-golden/, and CMake preset dirs under build/)
build*

# Test artifacts are staged here by devtools/run-tests and tracked in the
# orchestration repo's discussions/ (named by HEAD short hash), not here.
/discussions/

# CTest scratch output
/Testing/
/ddbsh/tests/Testing/

# examples build output (standalone external-consumer sample build dirs)
/examples/*/build*

# in-source CMake configure litter under the standalone examples. Prefer an
# out-of-source build (cmake -S . -B build), but an in-source `cmake .` leaves
# these behind; ignore them so a stray configure does not show up as untracked.
/examples/*/CMakeCache.txt
/examples/*/CMakeFiles/
/examples/*/cmake_install.cmake
/examples/*/CTestTestfile.cmake
/examples/*/Makefile