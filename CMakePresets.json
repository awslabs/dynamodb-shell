{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (gcc14)",
      "description": "Debug build with the gcc14 toolchain and the gcc14-built AWS SDK.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc14-gcc",
        "CMAKE_CXX_COMPILER": "gcc14-g++",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/aws-sdk-cpp"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (gcc14)",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux ASan+UBSan+LSan (gcc14)",
      "description": "Sanitizer build replacing the retired TEST_HARNESS leak tracker (D13).",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-sanitize",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": { "outputOnFailure": true }
    }
  ]
}
