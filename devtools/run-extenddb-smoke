#
# devtools/run-extenddb-smoke — the P6f-c REAL-BACKEND web gate against a REAL
# local ExtendDB server (D-P6f-3/D-P6f-7, §13 P6f-c).
#
# The companion to devtools/run-proxy-smoke. Where run-proxy-smoke proves the
# fetch edition over the proxy against real Amazon DynamoDB, THIS script proves
# the same fetch edition over the SAME proxy against a REAL local ExtendDB
# server — exercising the proxy's per-endpoint `profile` + `ca_bundle` mechanism
# (the ExtendDB-issued SigV4 key in a named AWS profile, and the self-signed TLS
# cert as the per-endpoint CA trust). ExtendDB is HTTPS-only.
#
# What it does:
#   1. build the proxy  (cargo build --release in proxy/),
#   2. build the fetch wasm edition  (emcmake wasm-release, like run-proxy-smoke),
#   3. locate the ExtendDB binary (a SQLite build) and init a FRESH deployment in
#      a temp dir (its own sqlite file + config; TLS cert reused from
#      ~/.extenddb/tls); set control_plane_delay_seconds 0 for fast transitions,
#   4. launch ExtendDB (serve --foreground) on loopback (teardown on exit),
#   5. create an IAM user + DynamoDB policy + access key, and write that key into
#      a TEMP AWS credentials file under a dedicated profile (the real ~/.aws is
#      never touched),
#   6. launch the proxy with that temp credentials file on its AWS chain
#      (teardown on exit),
#   7. run  node web/harness-extenddb.mjs  against it (ExtendDB, a
#      `ddbsh_web_extenddb_smoke_*`-prefixed table created + dropped),
#   8. capture everything into discussions/test-extenddbsmoke-<HEAD-short>.log.
#
# No credential ever reaches the browser or the harness. Everything is local and
# loopback; nothing touches a real AWS account.
#
# Env: EMSDK, EMSDK_PYTHON, DDBSH_WASM_BUILD_DIR (shared with run-web-smoke);
#      DDBSH_EXTENDDB_BIN (default ~/source/extenddb-READ-ONLY/target/release/extenddb),
#      DDBSH_EXTENDDB_PORT (default 18443), DDBSH_PROXY_PORT (default 8460),
#      DDBSH_REGION / AWS_REGION (default us-east-1).

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HASH="$(cd "$REPO_DIR" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
DISCUSSIONS_DIR="$REPO_DIR/discussions"
mkdir -p "$DISCUSSIONS_DIR"
LOG_FILE="$DISCUSSIONS_DIR/test-extenddbsmoke-${HASH}.log"

EXTENDDB_PORT="${DDBSH_EXTENDDB_PORT:-18443}"
PROXY_PORT="${DDBSH_PROXY_PORT:-8460}"
REGION="${DDBSH_REGION:-${AWS_REGION:-us-east-1}}"
EXTENDDB_BIN="${DDBSH_EXTENDDB_BIN:-$HOME/source/extenddb-READ-ONLY/target/release/extenddb}"
EXTENDDB_ENDPOINT="https://127.0.0.1:${EXTENDDB_PORT}"
PROFILE="ddbsh-extenddb-smoke"

echo "=== ExtendDB smoke: build the ddbsh-web-proxy ===" | tee "$LOG_FILE"
( cd "$REPO_DIR/proxy" && cargo build --release ) 2>&1 | tee -a "$LOG_FILE"
PROXY_BIN="$REPO_DIR/proxy/target/release/ddbsh-web-proxy"
if [ ! -x "$PROXY_BIN" ]; then
    echo "error: proxy binary not built at $PROXY_BIN" | tee -a "$LOG_FILE" >&2
    exit 1
fi

# --- Locate the emsdk toolchain + build the fetch wasm edition --------------
EMSDK_ROOT="${EMSDK:-$HOME/emsdk}"
if [ ! -f "$EMSDK_ROOT/emsdk_env.sh" ]; then
    echo "error: emsdk not found at '$EMSDK_ROOT' (set EMSDK or install per web/README.md)." | tee -a "$LOG_FILE" >&2
    exit 1
fi
if [ -z "${EMSDK_PYTHON:-}" ]; then
    if python3 -c 'import sys; sys.exit(0 if sys.version_info>=(3,10) else 1)' 2>/dev/null; then
        EMSDK_PYTHON="$(command -v python3)"
    else
        for cand in python3.13 python3.12 python3.11 python3.10; do
            if command -v "$cand" >/dev/null 2>&1; then
                EMSDK_PYTHON="$(command -v "$cand")"
                break
            fi
        done
    fi
fi
if [ -z "${EMSDK_PYTHON:-}" ]; then
    echo "error: no python >= 3.10 found for the emsdk scripts (set EMSDK_PYTHON)." | tee -a "$LOG_FILE" >&2
    exit 1
fi
export EMSDK_PYTHON EMSDK="$EMSDK_ROOT"
EMSDK_NODE_BIN="$(dirname "$(ls -d "$EMSDK_ROOT"/node/*/bin/node 2>/dev/null | head -1)" 2>/dev/null || true)"
export PATH="$EMSDK_ROOT:$EMSDK_ROOT/upstream/emscripten${EMSDK_NODE_BIN:+:$EMSDK_NODE_BIN}:$PATH"
if ! command -v emcmake >/dev/null 2>&1; then
    echo "error: emcmake not on PATH after emsdk setup (EMSDK=$EMSDK_ROOT)." | tee -a "$LOG_FILE" >&2
    exit 1
fi
NODE_BIN="$(command -v node)"

WASM_BUILD="${DDBSH_WASM_BUILD_DIR:-$REPO_DIR/build-preset/wasm-release}"
WEB_OUT="$WASM_BUILD/web"
echo "=== ExtendDB smoke: build the fetch wasm edition ===" | tee -a "$LOG_FILE"
if [ ! -f "$WASM_BUILD/CMakeCache.txt" ]; then
    ( cd "$REPO_DIR" && emcmake cmake --preset wasm-release ) 2>&1 | tee -a "$LOG_FILE"
fi
cmake --build "$WASM_BUILD" 2>&1 | tee -a "$LOG_FILE"
if [ ! -f "$WEB_OUT/ddbsh.js" ] || [ ! -f "$WEB_OUT/harness-extenddb.mjs" ]; then
    echo "error: fetch wasm edition / harness not staged at $WEB_OUT" | tee -a "$LOG_FILE" >&2
    exit 1
fi

# --- Locate ExtendDB + echo the target (no skip on missing) -----------------
echo "=== ExtendDB smoke: ExtendDB target ===" | tee -a "$LOG_FILE"
if [ ! -x "$EXTENDDB_BIN" ]; then
    echo "error: ExtendDB binary not found at '$EXTENDDB_BIN' (set DDBSH_EXTENDDB_BIN; build it with 'cargo build --release' in a SQLite checkout). This is an infrastructure failure, not a skip." | tee -a "$LOG_FILE" >&2
    exit 1
fi
EXTENDDB_VERSION="$("$EXTENDDB_BIN" --version 2>&1 | head -1 || true)"
if ! "$EXTENDDB_BIN" --version 2>&1 | grep -qi "sqlite"; then
    echo "error: ExtendDB binary at '$EXTENDDB_BIN' is not a SQLite build (need the embedded single-process backend). Infrastructure failure." | tee -a "$LOG_FILE" >&2
    exit 1
fi
CA_BUNDLE="$HOME/.extenddb/tls/cert.pem"
{
    echo "  binary:   $EXTENDDB_BIN"
    echo "  version:  $EXTENDDB_VERSION"
    echo "  endpoint: $EXTENDDB_ENDPOINT  (HTTPS, self-signed)"
    echo "  region:   $REGION"
} | tee -a "$LOG_FILE"

# --- A temp working dir for the ExtendDB deployment + the temp AWS creds -----
WORK_DIR="$(mktemp -d /tmp/ddbsh-extenddb-smoke.XXXXXX)"
EXTENDDB_CONFIG="$WORK_DIR/extenddb.toml"
EXTENDDB_SQLITE="$WORK_DIR/extenddb.sqlite"
AWS_CREDS_FILE="$WORK_DIR/aws-credentials"
AWS_CFG_FILE="$WORK_DIR/aws-config"
: >"$AWS_CFG_FILE"

EXTENDDB_PID=""
PROXY_PID=""
cleanup() {
    if [ -n "$PROXY_PID" ] && kill -0 "$PROXY_PID" 2>/dev/null; then
        kill "$PROXY_PID" 2>/dev/null || true
        wait "$PROXY_PID" 2>/dev/null || true
    fi
    if [ -n "$EXTENDDB_PID" ] && kill -0 "$EXTENDDB_PID" 2>/dev/null; then
        # serve --foreground writes no PID file; signal the PID we captured so
        # the exclusive SQLite lock is released.
        kill "$EXTENDDB_PID" 2>/dev/null || true
        wait "$EXTENDDB_PID" 2>/dev/null || true
    fi
    rm -rf "$WORK_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# --- Init a fresh ExtendDB deployment (SQLite, HTTPS) -----------------------
echo "=== ExtendDB smoke: init (SQLite, fresh catalog) ===" | tee -a "$LOG_FILE"
"$EXTENDDB_BIN" init --backend sqlite --sqlite-path "$EXTENDDB_SQLITE" \
    --config "$EXTENDDB_CONFIG" >"$WORK_DIR/init.out" 2>&1 || {
        echo "error: extenddb init failed:" | tee -a "$LOG_FILE" >&2
        cat "$WORK_DIR/init.out" | tee -a "$LOG_FILE" >&2
        exit 1
    }
cat "$WORK_DIR/init.out" >>"$LOG_FILE"
ADMIN_PW="$(sed -n 's/.*Password:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$WORK_DIR/init.out" | head -1)"
if [ -z "$ADMIN_PW" ]; then
    echo "error: could not parse the admin password from extenddb init output." | tee -a "$LOG_FILE" >&2
    exit 1
fi
if [ ! -f "$CA_BUNDLE" ]; then
    echo "error: ExtendDB TLS cert not found at $CA_BUNDLE after init." | tee -a "$LOG_FILE" >&2
    exit 1
fi

# Fast control-plane transitions (CREATE/DROP go ACTIVE/gone immediately), set
# before serve takes the SQLite lock.
"$EXTENDDB_BIN" settings --config "$EXTENDDB_CONFIG" set control_plane_delay_seconds 0 \
    >>"$LOG_FILE" 2>&1 || true

# --- Launch ExtendDB (foreground), teardown on exit -------------------------
echo "=== ExtendDB smoke: launch extenddb serve on 127.0.0.1:$EXTENDDB_PORT ===" | tee -a "$LOG_FILE"
EXTENDDB__SERVER__PORT="$EXTENDDB_PORT" "$EXTENDDB_BIN" serve --config "$EXTENDDB_CONFIG" --foreground \
    >>"$LOG_FILE" 2>&1 &
EXTENDDB_PID=$!

READY=""
for _ in $(seq 1 100); do
    if curl -fsS --cacert "$CA_BUNDLE" "$EXTENDDB_ENDPOINT/health" >/dev/null 2>&1; then
        READY=1
        break
    fi
    if ! kill -0 "$EXTENDDB_PID" 2>/dev/null; then
        echo "error: ExtendDB exited during startup (see log)." | tee -a "$LOG_FILE" >&2
        exit 1
    fi
    sleep 0.2
done
if [ -z "$READY" ]; then
    echo "error: ExtendDB did not become ready on $EXTENDDB_ENDPOINT" | tee -a "$LOG_FILE" >&2
    exit 1
fi
echo "  extenddb ready (pid $EXTENDDB_PID)" | tee -a "$LOG_FILE"

# --- Create an IAM user + DynamoDB policy + access key ----------------------
echo "=== ExtendDB smoke: issue a SigV4 key ===" | tee -a "$LOG_FILE"
ACCT_ID="$(EXTENDDB_PASSWORD="$ADMIN_PW" "$EXTENDDB_BIN" manage --user admin \
    --config "$EXTENDDB_CONFIG" list-accounts 2>>"$LOG_FILE" \
    | sed -n 's/.*"account_id":[[:space:]]*"\([0-9]*\)".*/\1/p' | head -1)"
if [ -z "$ACCT_ID" ]; then
    echo "error: could not determine the default ExtendDB account id." | tee -a "$LOG_FILE" >&2
    exit 1
fi
echo "  account:  $ACCT_ID" | tee -a "$LOG_FILE"

EXTENDDB_PASSWORD="$ADMIN_PW" "$EXTENDDB_BIN" manage --user admin --config "$EXTENDDB_CONFIG" \
    create-user --account-id "$ACCT_ID" --user-name ddbshweb >>"$LOG_FILE" 2>&1
EXTENDDB_PASSWORD="$ADMIN_PW" "$EXTENDDB_BIN" manage --user admin --config "$EXTENDDB_CONFIG" \
    put-user-policy --account-id "$ACCT_ID" --user-name ddbshweb \
    --policy-name FullAccess \
    --policy-document '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"dynamodb:*","Resource":"*"}]}' \
    >>"$LOG_FILE" 2>&1
KEY_JSON="$(EXTENDDB_PASSWORD="$ADMIN_PW" "$EXTENDDB_BIN" manage --user admin --config "$EXTENDDB_CONFIG" \
    create-access-key --account-id "$ACCT_ID" --user-name ddbshweb 2>>"$LOG_FILE")"
AKID="$(echo "$KEY_JSON" | sed -n 's/.*"access_key_id":[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
SECRET="$(echo "$KEY_JSON" | sed -n 's/.*"secret_access_key":[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
if [ -z "$AKID" ] || [ -z "$SECRET" ]; then
    echo "error: could not parse the issued access key from create-access-key." | tee -a "$LOG_FILE" >&2
    exit 1
fi
echo "  access key id: $AKID  (ExtendDB-issued; secret withheld from the log)" | tee -a "$LOG_FILE"

# Write the key into a TEMP AWS credentials file under the dedicated profile.
# The real ~/.aws is never touched. The proxy reads this file via the AWS chain.
umask 077
cat >"$AWS_CREDS_FILE" <<EOF
[$PROFILE]
aws_access_key_id = $AKID
aws_secret_access_key = $SECRET
EOF

# --- Launch the proxy pointed at the temp credentials file ------------------
echo "=== ExtendDB smoke: launch ddbsh-web-proxy on 127.0.0.1:$PROXY_PORT ===" | tee -a "$LOG_FILE"
AWS_SHARED_CREDENTIALS_FILE="$AWS_CREDS_FILE" AWS_CONFIG_FILE="$AWS_CFG_FILE" AWS_REGION="$REGION" \
    "$PROXY_BIN" --port "$PROXY_PORT" >>"$LOG_FILE" 2>&1 &
PROXY_PID=$!

READY=""
for _ in $(seq 1 50); do
    if curl -fsS "http://127.0.0.1:$PROXY_PORT/healthz" >/dev/null 2>&1; then
        READY=1
        break
    fi
    if ! kill -0 "$PROXY_PID" 2>/dev/null; then
        echo "error: proxy exited during startup (see log)." | tee -a "$LOG_FILE" >&2
        exit 1
    fi
    sleep 0.2
done
if [ -z "$READY" ]; then
    echo "error: proxy did not become ready on 127.0.0.1:$PROXY_PORT" | tee -a "$LOG_FILE" >&2
    exit 1
fi
echo "  proxy ready (pid $PROXY_PID)" | tee -a "$LOG_FILE"

# --- Run the harness against the real proxy + real local ExtendDB -----------
echo "=== ExtendDB smoke: run harness-extenddb.mjs ($HASH) ===" | tee -a "$LOG_FILE"
set +e
( cd "$WEB_OUT" \
    && DDBSH_PROXY_URL="http://127.0.0.1:$PROXY_PORT" \
       DDBSH_REGION="$REGION" \
       DDBSH_EXTENDDB_ENDPOINT="$EXTENDDB_ENDPOINT" \
       DDBSH_EXTENDDB_PROFILE="$PROFILE" \
       DDBSH_EXTENDDB_CA_BUNDLE="$CA_BUNDLE" \
    "$NODE_BIN" harness-extenddb.mjs ) 2>&1 | tee -a "$LOG_FILE"
RC=${PIPESTATUS[0]}
set -e

echo "=== ExtendDB smoke exit: $RC ===" | tee -a "$LOG_FILE"
echo "  artifact: $LOG_FILE"
exit "$RC"
