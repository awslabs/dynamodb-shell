#!/usr/bin/env bash
# Copyright 2026 ddbsh reimplementation contributors.
# SPDX-License-Identifier: Apache-2.0
#
# devtools/stage-extenddb-webasm — drop the in-browser ExtendDB WASM adapter
# into a target bundle directory's vendor/extenddb/ (P6f-d, D-P6f-8).
#
# ddbsh NEVER ships or commits the adapter blob: the ddbsh build stages only
# ddbsh's own files. The adapter is a third-party, drop-in dependency of the
# browser *in-tab* edition (ddbsh-wasm-extenddb-wasm, SubmitTransport) only. This
# helper performs that drop-in for the dev/test loop; a deploy does the same by
# hand (see web/vendor/extenddb/PROVENANCE.md).
#
# Usage:   devtools/stage-extenddb-webasm <target-dir>
#   copies the pinned adapter files into <target-dir>/vendor/extenddb/.
#
# Source: DDBSH_EXTENDDB_WEBASM_PKG (default below) — a built
#   extenddb-wasm-adapter package directory (the upstream repo's
#   samples/webasm-storefront/pkg). A missing/incomplete package is an
#   INFRASTRUCTURE FAILURE (nonzero exit), never a silent skip: the in-tab
#   edition cannot run without it. The pinned version is enforced.

set -euo pipefail

PINNED_VERSION="0.1.26"
DEFAULT_PKG="$HOME/source/extenddb-webasm/samples/webasm-storefront/pkg"
PKG_DIR="${DDBSH_EXTENDDB_WEBASM_PKG:-$DEFAULT_PKG}"

# The adapter files that make up the drop-in (the JS glue + the engine wasm +
# the type/manifest files the PROVENANCE records).
ADAPTER_FILES=(
    extenddb_wasm_adapter.js
    extenddb_wasm_adapter_bg.wasm
    extenddb_wasm_adapter.d.ts
    extenddb_wasm_adapter_bg.wasm.d.ts
    package.json
)

if [ "$#" -ne 1 ]; then
    echo "usage: $0 <target-dir>" >&2
    exit 2
fi
TARGET_DIR="$1"

if [ ! -d "$TARGET_DIR" ]; then
    echo "stage-extenddb-webasm: target dir not found: $TARGET_DIR" >&2
    exit 2
fi

if [ ! -d "$PKG_DIR" ]; then
    echo "stage-extenddb-webasm: ExtendDB WASM adapter package not found at '$PKG_DIR'." >&2
    echo "  Set DDBSH_EXTENDDB_WEBASM_PKG to a built extenddb-wasm-adapter@${PINNED_VERSION}" >&2
    echo "  package directory (see web/vendor/extenddb/PROVENANCE.md). This is the" >&2
    echo "  in-browser edition's drop-in dependency; it is not shipped with ddbsh." >&2
    exit 1
fi

# Validate the pinned version before copying (never float the adapter).
PKG_JSON="$PKG_DIR/package.json"
if [ ! -f "$PKG_JSON" ]; then
    echo "stage-extenddb-webasm: no package.json in '$PKG_DIR' — not an adapter package." >&2
    exit 1
fi
FOUND_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PKG_JSON" | head -1)"
if [ "$FOUND_VERSION" != "$PINNED_VERSION" ]; then
    echo "stage-extenddb-webasm: adapter version mismatch at '$PKG_DIR'." >&2
    echo "  expected (pinned) ${PINNED_VERSION}, found '${FOUND_VERSION}'." >&2
    echo "  Bumping the pin is a deliberate, reviewed change (PROVENANCE.md)." >&2
    exit 1
fi

# Verify every adapter file is present before staging (fail closed).
for f in "${ADAPTER_FILES[@]}"; do
    if [ ! -f "$PKG_DIR/$f" ]; then
        echo "stage-extenddb-webasm: adapter file missing from package: $f" >&2
        exit 1
    fi
done

DEST="$TARGET_DIR/vendor/extenddb"
mkdir -p "$DEST"
for f in "${ADAPTER_FILES[@]}"; do
    cp -f "$PKG_DIR/$f" "$DEST/$f"
done

echo "stage-extenddb-webasm: staged extenddb-wasm-adapter@${PINNED_VERSION} -> $DEST"
