#!/usr/bin/env bash
# Copyright 2026 ddbsh reimplementation contributors.
# SPDX-License-Identifier: Apache-2.0
#
# devtools/run-tests — code-repo test entry point.
#
# Runs the CTest golden suite against REAL DynamoDB (us-east-1) using the
# standard AWS resolution chain (~/.aws credentials/config, AWS_PROFILE,
# AWS_REGION). No endpoint override is used; DynamoDB Local and extenddb are not
# used (human decisions 2026-08-17/22).
#
# Golden family routing (Step 2b, D24): as command families port to the
# reimplementation, their golden families run against the NEW engine (the
# shipping `ddbsh` binary driven through the external harness in
# tests/golden/), while every non-routed family keeps running on the original
# C++11 oracle. This script builds BOTH — the oracle (oracle/) and the new
# engine (the top-level C++23 tree) — then runs the routed families on the new
# engine and the complement on the oracle, so the combined suite equals an
# all-oracle run in the same environment (no test is dropped). The routed set
# (ROUTED_RE) grows family-by-family until the step-2 exit gate empties the
# oracle route table entirely.
#
# The test target (endpoint + access key id) is echoed and verified before any
# test runs. Two artifacts are written into this repo's discussions/ directory,
# named by the current HEAD short hash so they are tracked in version control
# and copied back by the orchestration repo's devtools/run-tests:
#
#   discussions/test-<suite>-<HEAD-short>.log   full ctest output (both sub-runs)
#   discussions/test-<suite>-<HEAD-short>.txt   summary (target + combined counts)
#
# Usage:
#   devtools/run-tests                     # full suite (label: all)
#   devtools/run-tests -R isel             # ctest regex filter (label derived)
#   devtools/run-tests --suite select -R isel
#   AWS_PROFILE=p AWS_REGION=us-east-1 devtools/run-tests
#
# Env overrides: DDBSH_ROUTED_RE (routed-family regex), DDBSH_ENGINE_BUILD_DIR,
# DDBSH_GOLDEN_BUILD_DIR, DDBSH_SDK_PREFIX, DDBSH_SDK_LIB, CC/CXX.
#
# WARNING: this talks to a real AWS account. create/insert/update/delete/drop
# operate on real tables and data, incur real cost, and are irreversible. Use a
# dedicated test account/region.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# --- Argument parsing -------------------------------------------------------
# Optional --suite <label>; all other args pass through to ctest.
SUITE=""
CTEST_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --suite)
            SUITE="${2:-}"
            shift 2
            ;;
        *)
            CTEST_ARGS+=("$1")
            shift
            ;;
    esac
done

# Derive a suite label if not given: use the -R regex if present, else "all".
if [ -z "$SUITE" ]; then
    for ((i = 0; i < ${#CTEST_ARGS[@]}; i++)); do
        if [ "${CTEST_ARGS[$i]}" = "-R" ]; then
            SUITE="${CTEST_ARGS[$((i + 1))]:-all}"
            break
        fi
    done
fi
[ -z "$SUITE" ] && SUITE="all"
# Sanitize the label for use in a filename.
SUITE="$(printf '%s' "$SUITE" | tr -c 'A-Za-z0-9._-' '-')"

# --- Repo / build resolution ------------------------------------------------
HASH="$(cd "$REPO_DIR" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
BUILD_DIR="${DDBSH_BUILD_DIR:-$REPO_DIR/build}"
# The fidelity oracle is the original C++11 ddbsh, relocated to oracle/ when the
# reimplementation took over the top-level tree (P2a-01 D-Q3). This is the
# golden-suite build the harness exercises against real DynamoDB; the C++23
# reimplementation (include/ src/ cli/ tests/) is built separately via presets.
SRC_DIR="$REPO_DIR/oracle"
DISCUSSIONS_DIR="$REPO_DIR/discussions"
mkdir -p "$DISCUSSIONS_DIR"

LOG_FILE="$DISCUSSIONS_DIR/test-${SUITE}-${HASH}.log"
SUMMARY_FILE="$DISCUSSIONS_DIR/test-${SUITE}-${HASH}.txt"

# AWS SDK install prefix (where AWSSDKConfig.cmake / the libs live). The oracle
# CMake resolves the SDK via find_package(AWSSDK), so first-time configure must
# be told the prefix; overridable via DDBSH_SDK_PREFIX.
DDBSH_SDK_PREFIX="${DDBSH_SDK_PREFIX:-$HOME/.local/aws-sdk-cpp}"
# Compiler: the prebuilt AWS SDK was compiled with gcc14; the oracle must link
# against it with the same toolchain (default cc/c++ = gcc 11 fails to resolve
# __cxa_call_terminate against the gcc14-built CRT static libs). Overridable
# via CC/CXX for other environments.
DDBSH_CC="${CC:-gcc14-gcc}"
DDBSH_CXX="${CXX:-gcc14-g++}"
# AWS SDK shared libraries (mirrors devtools/ddbsh-aws in the orchestration repo).
export LD_LIBRARY_PATH="${DDBSH_SDK_LIB:-$DDBSH_SDK_PREFIX/lib64}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Prefer the regional STS endpoint (the legacy global endpoint is disabled on
# some accounts; cross-account AssumeRole tests need this).
export AWS_STS_REGIONAL_ENDPOINTS="${AWS_STS_REGIONAL_ENDPOINTS:-regional}"

REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}"
export AWS_REGION="$REGION"

# --- Golden family routing (Step 2b, D24) -----------------------------------
# As the reimplementation ports command families, their golden families are
# routed off the original C++11 oracle and onto the NEW engine (the shipping
# `ddbsh` binary driven through the external harness, tests/golden/).
# The oracle runs the COMPLEMENT (every non-routed family) so the combined suite
# equals an all-oracle run in the same environment — no test is dropped.
#
# ROUTED_RE is the CTest name regex for the families currently on the new
# engine. 2b (D24): symbol-table (ist-*), select (isel-*), insert (iins-*).
# The step-2 exit gate empties this (every family on the new engine, oracle
# wiring removed); it grows family-by-family in 2c+ until then.
ROUTED_RE="${DDBSH_ROUTED_RE:-^(ist-|isel-|iins-)}"
ENGINE_SRC="$REPO_DIR"
ENGINE_BUILD="${DDBSH_ENGINE_BUILD_DIR:-$REPO_DIR/build-engine}"
GOLDEN_SRC="$REPO_DIR/tests/golden"
GOLDEN_BUILD="${DDBSH_GOLDEN_BUILD_DIR:-$REPO_DIR/build-golden}"
DDBSH_SDK_LIB="${DDBSH_SDK_LIB:-$DDBSH_SDK_PREFIX/lib64}"

# --- Build: original oracle (runs the non-routed families) ------------------
if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
    echo "=== Configuring oracle build (no CMakeCache at $BUILD_DIR) ==="
    cmake -S "$SRC_DIR" -B "$BUILD_DIR" \
        -DCMAKE_PREFIX_PATH="$DDBSH_SDK_PREFIX" \
        -DCMAKE_C_COMPILER="$DDBSH_CC" \
        -DCMAKE_CXX_COMPILER="$DDBSH_CXX"
fi
echo "=== Building oracle ddbsh/ddbshtest ($HASH) ==="
cmake --build "$BUILD_DIR"

if [ ! -x "$BUILD_DIR/ddbshtest" ]; then
    echo "error: $BUILD_DIR/ddbshtest not found after build." >&2
    exit 1
fi

# Expose the oracle binary under the human-facing name `ddbsh-old` (the new
# shipping engine binary is `ddbsh`; human decision 2026-10-14). oracle/ source
# stays pristine — this is build glue only. A relative symlink avoids a stale
# copy drifting from the oracle build.
if [ -x "$BUILD_DIR/ddbsh" ]; then
    ln -sf ddbsh "$BUILD_DIR/ddbsh-old"
fi

# --- Build: new engine (runs the routed families via the golden harness) ----
if [ ! -f "$ENGINE_BUILD/CMakeCache.txt" ]; then
    echo "=== Configuring new-engine build (no CMakeCache at $ENGINE_BUILD) ==="
    cmake -S "$ENGINE_SRC" -B "$ENGINE_BUILD" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$DDBSH_SDK_PREFIX" \
        -DCMAKE_C_COMPILER="$DDBSH_CC" \
        -DCMAKE_CXX_COMPILER="$DDBSH_CXX" \
        -DDDBSH_BUILD_TESTS=OFF
fi
echo "=== Building new-engine ddbsh CLI ($HASH) ==="
cmake --build "$ENGINE_BUILD" --target ddbsh-cli

ENGINE_BIN="$ENGINE_BUILD/ddbsh"
if [ ! -x "$ENGINE_BIN" ]; then
    echo "error: $ENGINE_BIN not found after build." >&2
    exit 1
fi

# --- Configure: golden parity project (reuses the oracle family files) ------
echo "=== Configuring golden-parity project (routed families -> new engine) ==="
cmake -S "$GOLDEN_SRC" -B "$GOLDEN_BUILD" \
    -DDDBSH_SHELL_BIN="$ENGINE_BIN" \
    -DDDBSH_SDK_LIB="$DDBSH_SDK_LIB" \
    -DORACLE_TESTS_DIR="$SRC_DIR/tests"

# --- Target echo + verification ---------------------------------------------
# No endpoint override => the real regional DynamoDB endpoint.
ENDPOINT="dynamodb.${REGION}.amazonaws.com (real DynamoDB, no override)"
ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-$(aws configure get aws_access_key_id 2>/dev/null || true)}"
[ -z "$ACCESS_KEY_ID" ] && ACCESS_KEY_ID="(unresolved)"
CALLER_ARN="$(aws sts get-caller-identity --query Arn --output text --region "$REGION" 2>/dev/null || echo '(sts unavailable)')"

{
    echo "ddbsh test run"
    echo "  commit:        $HASH"
    echo "  suite:         $SUITE"
    echo "  timestamp:     $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "  region:        $REGION"
    echo "  endpoint:      $ENDPOINT"
    echo "  access key id: $ACCESS_KEY_ID"
    echo "  caller arn:    $CALLER_ARN"
} | tee "$SUMMARY_FILE"

if [ "$ACCESS_KEY_ID" = "(unresolved)" ]; then
    echo "error: could not resolve an AWS access key id; refusing to run against an unknown target." >&2
    echo "  provide credentials via ~/.aws or AWS_ACCESS_KEY_ID/AWS_PROFILE." | tee -a "$SUMMARY_FILE" >&2
    exit 1
fi

# --- Run --------------------------------------------------------------------
# Two sub-runs, serial (tables share state within a family):
#   1. new engine  — the routed families (ROUTED_RE) via the golden harness
#   2. oracle      — every non-routed family (-E ROUTED_RE)
# Any passthrough CTEST_ARGS (e.g. -R isel) apply to BOTH, so a filter that
# targets a routed family runs only on the new engine and a non-routed filter
# runs only on the oracle. The combined pass/fail is the suite result.
ENGINE_LOG="${LOG_FILE%.log}-engine.log"
ORACLE_LOG="${LOG_FILE%.log}-oracle.log"

echo "=== Running NEW-ENGINE routed families ($ROUTED_RE) ===" | tee -a "$SUMMARY_FILE"
set +e
ctest --test-dir "$GOLDEN_BUILD" --output-on-failure \
    ${CTEST_ARGS[@]+"${CTEST_ARGS[@]}"} 2>&1 | tee "$ENGINE_LOG"
RC_ENGINE=${PIPESTATUS[0]}

echo "=== Running ORACLE non-routed families (-E $ROUTED_RE) ===" | tee -a "$SUMMARY_FILE"
ctest --test-dir "$BUILD_DIR" --output-on-failure -E "$ROUTED_RE" \
    ${CTEST_ARGS[@]+"${CTEST_ARGS[@]}"} 2>&1 | tee "$ORACLE_LOG"
RC_ORACLE=${PIPESTATUS[0]}
set -e

# Extract per-run counts from each sub-run's OWN log (not head/tail of the
# merged log, which would mis-assign when one side ran no tests). ctest prints
# "<pct>% tests passed, <F> tests failed out of <N>", so passed = N - F. All of
# this tolerates a sub-run with no summary line without aborting under set -e.
counts() {
    # $1 = ctest log file; echoes "<passed> <total>"
    local line out failed
    line="$(grep -E "tests passed|tests failed" "$1" 2>/dev/null | tail -1 || true)"
    out="$(grep -oE "out of [0-9]+" <<<"$line" 2>/dev/null | grep -oE "[0-9]+" || true)"
    failed="$(grep -oE "[0-9]+ tests failed" <<<"$line" 2>/dev/null | grep -oE "[0-9]+" || true)"
    out=${out:-0}
    failed=${failed:-0}
    echo "$((out - failed)) $out"
}
read -r e_pass e_out < <(counts "$ENGINE_LOG")
read -r o_pass o_out < <(counts "$ORACLE_LOG")

# Combine the two logs into the canonical artifact.
{
    echo "=== NEW-ENGINE (routed: $ROUTED_RE) ==="
    cat "$ENGINE_LOG"
    echo ""
    echo "=== ORACLE (non-routed) ==="
    cat "$ORACLE_LOG"
} > "$LOG_FILE"
rm -f "$ENGINE_LOG" "$ORACLE_LOG"

RC=0
# ctest exit code 8 == "no tests were found": benign for a sub-run when a user
# -R filter targets only the OTHER side (the complement carries the tests). A
# real test failure is a nonzero code other than 8.
benign() { [ "$1" -eq 0 ] || [ "$1" -eq 8 ]; }
benign "$RC_ENGINE" || RC=$RC_ENGINE
benign "$RC_ORACLE" || RC=$RC_ORACLE

{
    echo ""
    echo "=== ctest summary ==="
    echo "  new engine (routed):  ${e_pass}/${e_out} passed"
    echo "  oracle (non-routed):  ${o_pass}/${o_out} passed"
    echo "  combined:             $((e_pass + o_pass))/$((e_out + o_out)) passed"
    grep -E "Total Test time|Errors while running CTest" "$LOG_FILE" || true
    echo ""
    echo "ctest exit codes: engine=$RC_ENGINE oracle=$RC_ORACLE (combined=$RC)"
} | tee -a "$SUMMARY_FILE"

echo "=== Artifacts ==="
echo "  $LOG_FILE"
echo "  $SUMMARY_FILE"

exit $RC
